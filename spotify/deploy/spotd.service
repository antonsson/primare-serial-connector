# systemd user unit: ~/.config/systemd/user/spotd.service
# Runs next to soloist.service. Needs: loginctl enable-linger <user>
[Unit]
Description=spotd: sync Spotify Soloist with the Primare I22
After=soloist.service
Wants=soloist.service

[Service]
# Set -usb-input to the I22 input wired to USB and -card to the id in /proc/asound.
ExecStart=%h/.local/bin/spotd -usb-input 7 -card v10 -max-volume 50 -idle 20m
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
