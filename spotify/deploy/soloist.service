# systemd user unit: ~/.config/systemd/user/soloist.service
# Key file ~/.config/soloist/env (chmod 600):  SOLOIST_API_KEY=...
[Unit]
Description=Spotify Soloist (Spotify Connect)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
EnvironmentFile=%h/.config/soloist/env
# -d: PipeWire node.name of the I22 (wpctl status / pw-cli ls Node)
ExecStart=/usr/bin/soloist -n Vardagsrum -i 30 -k ${SOLOIST_API_KEY} -d alsa_output.usb-Primare_Primare_I22_v1.0-00.analog-stereo --ws 127.0.0.1:9090
Restart=always
RestartSec=3
# Exit 10 = build expired (90 days): stop instead of restart-looping; upgrade the AUR package.
RestartPreventExitStatus=10

[Install]
WantedBy=default.target
